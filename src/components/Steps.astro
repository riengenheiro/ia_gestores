---
import { eventData } from '../data/event';
---

<section class="steps-section">
  <div class="container">
    <h2 class="steps-title">{eventData.stepsTitle}</h2>
    <div class="steps-grid">
      {eventData.steps.map((step, index) => (
        <article class="step">
          <div class="step-num font-anton" aria-hidden="true">{index + 1}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-section {
    padding: 64px 0;
    background: var(--color-white);
  }
  .steps-title {
    font-size: 34px;
    font-weight: 800;
    color: var(--color-dark);
    text-align: center;
    margin-bottom: 36px;
    line-height: 1.15;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 960px;
    margin: 0 auto;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .step-num {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    line-height: 1;
    margin-bottom: 4px;
  }
  .step h3 {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-dark);
  }
  .step p {
    font-size: 14.5px;
    color: var(--color-gray-medium);
    line-height: 1.6;
  }
  @media (max-width: 800px) {
    .steps-title { font-size: 26px; }
    .steps-grid { grid-template-columns: 1fr; max-width: 420px; }
  }
</style>

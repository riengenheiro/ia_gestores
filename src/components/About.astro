---
import { eventData } from '../data/event';
const s = eventData.speaker;
const initials = s.name.split(' ').map((p) => p[0]).join('').slice(0, 2);
---

<section class="about-section">
  <div class="container about-grid">
    <div class="about-photo-col">
      {s.photo ? (
        <div class="about-photo">
          <img src={s.photo} alt={s.name} loading="lazy" />
        </div>
      ) : (
        <div class="about-avatar about-initials font-anton" aria-hidden="true">{initials}</div>
      )}
    </div>

    <div class="about-text-col">
      <span class="about-tag">QUEM CONDUZ A NOITE</span>
      <h2 class="about-title">{s.name}</h2>
      <p class="about-role">{s.role}</p>
      {s.bio.map((p) => <p class="about-bio">{p}</p>)}
      <p class="about-bio about-bio-strong">
        No IA para Gestores, Kelly apresenta aplicações reais e mostra como a inteligência artificial pode se tornar uma aliada da gestão.
      </p>
      <a href={s.instagram} target="_blank" rel="noopener noreferrer" class="about-link">Ver o perfil no Instagram &rarr;</a>
      <a href="#ingressos" class="btn-primary about-cta">GARANTIR MINHA VAGA · R$ {eventData.priceLot}</a>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 64px 0;
    background-color: var(--color-light-bg);
    border-top: 1px solid var(--color-gray-border);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    align-items: start;
    max-width: 960px;
  }
  .about-photo-col { display: flex; justify-content: center; }
  .about-avatar {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    border: 5px solid var(--color-white);
    box-shadow: 0 12px 30px rgba(224, 64, 28, 0.2);
  }
  .about-photo {
    width: 260px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 5px solid var(--color-white);
    box-shadow: 0 12px 30px rgba(224, 64, 28, 0.2);
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }
  .about-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e0401c, #ff7a52);
    color: var(--color-white);
    font-size: 84px;
    letter-spacing: 2px;
  }
  .about-tag { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; color: var(--color-primary); }
  .about-title { font-size: 34px; font-weight: 800; color: var(--color-dark); line-height: 1.15; margin-top: 4px; }
  .about-role { font-size: 15px; font-weight: 600; color: var(--color-gray-medium); margin-bottom: 18px; }
  .about-bio { font-size: 15.5px; color: var(--color-gray-dark); line-height: 1.7; margin-bottom: 14px; }
  .about-bio-strong { font-weight: 700; color: var(--color-dark); }
  .about-link { font-size: 15px; font-weight: 700; color: var(--color-primary); }
  .about-cta { margin-top: 18px; }
  .about-link:hover { text-decoration: underline; }
  @media (max-width: 800px) {
    .about-grid { grid-template-columns: 1fr; gap: 24px; text-align: center; }
    .about-avatar { width: 180px; height: 180px; }
    .about-photo { width: 220px; }
    .about-initials { font-size: 64px; }
    .about-title { font-size: 27px; }
    .about-cta { width: 100%; }
  }
</style>

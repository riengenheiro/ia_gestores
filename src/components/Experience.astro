---
import { eventData } from '../data/event';
---

<section class="experience-section">
  <div class="container">
    <div class="experience-header">
      <h2 class="experience-title">O que você vai descobrir</h2>
    </div>

    <div class="experience-cards-grid">
      {eventData.takeaways.map((card) => (
        <article class="experience-card">
          <span class="card-num font-anton">{card.num}</span>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-text">{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    padding: 64px 0;
    background-color: var(--color-white);
    scroll-margin-top: 72px;
  }
  .experience-header { text-align: center; margin-bottom: 40px; }
  .experience-title { font-size: 32px; font-weight: 800; color: var(--color-dark); }
  .experience-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .experience-card {
    background-color: var(--color-light-bg);
    border-radius: var(--radius-xl);
    padding: 32px 26px;
    border: 1px solid var(--color-gray-border);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .experience-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
  .card-num { font-size: 44px; color: var(--color-primary); line-height: 1; display: block; margin-bottom: 14px; }
  .card-title { font-size: 19px; font-weight: 800; color: var(--color-primary); margin-bottom: 12px; line-height: 1.25; }
  .card-text { font-size: 14.5px; color: var(--color-gray-medium); line-height: 1.65; }
  @media (max-width: 900px) {
    .experience-cards-grid { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; }
    .experience-title { font-size: 25px; }
  }
</style>

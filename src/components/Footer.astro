---
import { eventData } from '../data/event';
---

<footer class="footer-section">
  <div class="container footer-grid">
    <div>
      <p class="footer-label">Links</p>
      <nav class="footer-links" aria-label="Rodapé">
        <a href="#ingressos">Inscrição</a>
        <a href="#faq">Perguntas</a>
        <a href={eventData.speaker.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="#">Privacidade</a>
      </nav>
    </div>
    <div>
      <p class="footer-label">Pagamento</p>
      <p class="footer-text">Pix (na hora) ou cartão de crédito</p>
    </div>
    <div>
      <p class="footer-label">O encontro</p>
      <p class="footer-text">{eventData.footerLine}</p>
      <p class="footer-text">{eventData.venueName}</p>
      <p class="footer-text">{eventData.venueAddress}</p>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    background: #0f0f11;
    color: var(--color-white);
    padding: 48px 0 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 960px;
  }
  .footer-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-links a {
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.5;
  }
  .footer-links a:hover { color: var(--color-white); }
  .footer-text {
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.6;
    margin-bottom: 6px;
  }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

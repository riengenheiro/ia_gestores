---
import { eventData } from '../data/event';
---

<section class="testimonials-section">
  <div class="container">
    <h2 class="testimonials-title">O que dizem</h2>
    <div class="testimonials-grid">
      {eventData.testimonials.map((t) => (
        <figure class="quote-card">
          <blockquote>
            {t.highlight && <p class="quote-highlight">“{t.highlight}”</p>}
            {t.paragraphs.map((p) => <p class="quote-text">{p}</p>)}
          </blockquote>
          <figcaption>
            <span class="quote-initial font-anton" aria-hidden="true">{t.name.trim().charAt(0)}</span>
            <span class="quote-person">
              <strong>{t.name}</strong>
              <span>{t.source}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 56px 0;
    background: var(--color-light-bg);
  }
  .testimonials-title {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 28px;
    line-height: 1.15;
    text-align: center;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .quote-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-border);
    border-radius: var(--radius-xl);
    padding: 28px 24px;
  }
  .quote-highlight {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-dark);
    margin-bottom: 14px;
  }
  .quote-text {
    font-size: 14.5px;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-gray-medium);
    margin-bottom: 10px;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .quote-initial {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(224, 64, 28, 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .quote-person {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .quote-person strong { font-size: 15px; color: var(--color-dark); }
  .quote-person span { font-size: 13px; color: var(--color-gray-light); }
  @media (max-width: 960px) {
    .testimonials-grid { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
  }
  @media (max-width: 768px) {
    .testimonials-title { font-size: 26px; }
  }
</style>

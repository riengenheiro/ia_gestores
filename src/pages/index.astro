>
  <TopBar />
  <main>
    <Hero />
    <Highlights />
    <Hook />
    <Experience />
    <Testimonials />
    <Logistics />
    <Pricing />
    <Steps />
    <Policy />
    <About />
    <Numbers />
    <Faq />
  </main>
  <Footer />
</Layout>
